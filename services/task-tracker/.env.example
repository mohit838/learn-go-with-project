# App Information
APP_ENV=development
APP_NAME=task-tracker-service
APP_VERSION=1.0.0
APP_PORT=8485
APP_DEBUG=true
APP_LOG_LEVEL=debug

# PostgreSQL
DB_HOST=localhost
DB_PORT=1234
DB_NAME=task_manager_db
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgres://your_postgres_user:your_postgres_password@localhost:1234/task_manager_db?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=1236
REDIS_USER=your_redis_user
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://your_redis_user:your_redis_password@localhost:1236/1

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=1235
MONGO_DB=task_log_db
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password
MONGO_URL=mongodb://your_mongo_user:your_mongo_password@localhost:1235/task_log_db?authSource=admin

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=task-tracker
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

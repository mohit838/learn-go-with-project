# App Information
APP_ENV=development
APP_NAME=task-tracker-service
APP_VERSION=1.0.0
APP_PORT=8485
APP_DEBUG=true
APP_LOG_LEVEL=debug

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=1234
POSTGRES_DB=task_manager_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgres://your_postgres_user:your_postgres_password@localhost:1234/task_manager_db?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=1236
REDIS_USER=your_redis_user
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://your_redis_user:your_redis_password@localhost:1236/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=task-tracker
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
